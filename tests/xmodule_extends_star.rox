// A type extending a star-imported type must resolve bare inherited member
// names inside its own methods: the imported module's compile-time member
// metadata has to cross the module boundary.
import xmodule_helper.*

type D object extends Base:
  var b :int = 2
  func show():
    print(a)
    a = a + 1
    print(a)
    hello()

var d = D()
d.show()
print(d.b)
